{
	"name": "@salik1992/tv-tools-monorepo",
	"private": true,
	"type": "module",
	"version": "1.0.0",
	"description": "Monorepository for TV Tools",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"prepare": "husky",
		"postinstall": "patch-package",
		"dev": "npm run build --workspace @salik1992/tv-tools && npm run build --workspace @salik1992/tv-tools-react && npm run build --workspace @salik1992/test-app-data && npm run build --workspace @salik1992/test-app-data-tmdb && npm run dev --workspace @salik1992/test-app-react",
		"lintcheck": "npm run lintcheck --workspaces",
		"lintfix": "npm run lintcheck --workspaces -- --fix",
		"test": "jest",
		"test:coverage": "jest --coverage",
		"typecheck": "npm run typecheck --workspaces"
	},
	"author": "Vit Salomon (salik1992)",
	"license": "mixed",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@trivago/prettier-plugin-sort-imports": "^5.2.2",
		"@types/jest": "^29.5.14",
		"@types/node": "^25.7.0",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.5",
		"eslint-plugin-react": "^7.37.5",
		"globals": "^17.6.0",
		"husky": "^9.1.7",
		"jest": "^29.7.0",
		"jest-environment-jsdom": "^29.7.0",
		"lint-staged": "^17.0.4",
		"patch-package": "^8.0.1",
		"prettier": "^3.8.3",
		"ts-jest": "^29.4.9",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.3"
	}
}
